{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "ui/public/favicon.svg",
  "scripts": [
    {
      "name": "UI Dev",
      "command": "cd ui && bun run dev",
      "icon": "play",
      "stopOnSettle": true,
      "previewUrl": "http://localhost:5173"
    },
    {
      "name": "Install Dependencies",
      "command": "make ensure-ui-embed && cd ui && bun install --frozen-lockfile",
      "icon": "configure"
    },
    {
      "name": "Test",
      "command": "make test",
      "icon": "test"
    },
    {
      "name": "Lint",
      "command": "make lint-fix",
      "icon": "lint"
    }
  ]
}
