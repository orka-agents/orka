{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "ui/public/favicon.svg",
  "scripts": [
    {
      "name": "UI Dev",
      "command": "cd ui && bun run dev --strictPort",
      "icon": "play",
      "stopOnSettle": true,
      "previewUrl": "http://localhost:5173"
    },
    {
      "name": "UI Dependencies",
      "command": "cd ui && bun install --frozen-lockfile",
      "icon": "configure"
    },
    {
      "name": "Test",
      "command": "make test",
      "icon": "test"
    },
    {
      "name": "Lint",
      "command": "make lint-fix",
      "icon": "lint"
    },
    {
      "name": "Generate",
      "command": "make manifests generate",
      "icon": "build"
    },
    {
      "name": "Kind Up",
      "command": ".agents/skills/kindctl/bin/kindctl create",
      "icon": "configure"
    },
    {
      "name": "Kind Deploy",
      "command": ".agents/skills/kindctl/bin/kindctl exec -- sh -c '.agents/skills/orka-kind-deploy/scripts/deploy_orka_kind.sh --cluster \"$(basename \"$KUBECONFIG\" .kubeconfig)\"'",
      "icon": "build"
    },
    {
      "name": "Kind Down",
      "command": ".agents/skills/kindctl/bin/kindctl delete",
      "icon": "configure"
    }
  ]
}
