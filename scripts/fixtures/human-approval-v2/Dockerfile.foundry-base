FROM gcr.io/distroless/static:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7
COPY --chown=0:0 --chmod=0555 agent-runtime-foundry /agent-runtime-foundry
WORKDIR /agent
COPY --chown=0:0 --chmod=0444 foundry.json /agent/foundry.json
USER 65532:65532
ENTRYPOINT ["/agent-runtime-foundry"]
CMD ["--protocol", "acp", "--config", "/agent/foundry.json"]
