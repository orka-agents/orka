+		if detail != "" {
+			return "", fmt.Errorf("while reading runsc container state: %w: %s", err, detail)
+		}
+		return "", fmt.Errorf("while reading runsc container state: %w", err)
+	}
+	var state struct {
+		Status string `json:"status"`
+	}
+	if err := json.Unmarshal(stdout.Bytes(), &state); err != nil {
+		return "", fmt.Errorf("while parsing runsc container state: %w", err)
+	}
+	if state.Status == "" {
+		return "", fmt.Errorf("runsc container state omitted status")
+	}
+	return strings.ToLower(state.Status), nil
+}
