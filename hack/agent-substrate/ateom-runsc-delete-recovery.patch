+func TestPrepareCheckpointRestoreRemovesMarkedCompatibilityFiles(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "checkpoint.img"), []byte("checkpoint\n"), 0o600); err != nil {
+		t.Fatalf("write checkpoint: %v", err)
+	}
+	compatibility := map[string]string{
+		"pages.img":      checkpointPagesCompatibilityMarker,
+		"pages_meta.img": checkpointPagesMetadataCompatibilityMarker,
+	}
+	for name, marker := range compatibility {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(marker), 0o600); err != nil {
+			t.Fatalf("write %s: %v", name, err)
+		}
+	}
+	if err := prepareCheckpointRestore(dir); err != nil {
+		t.Fatalf("prepareCheckpointRestore() error = %v", err)
+	}
+	for name := range compatibility {
+		if _, err := os.Stat(filepath.Join(dir, name)); !errors.Is(err, os.ErrNotExist) {
+			t.Fatalf("compatibility file %s still exists: %v", name, err)
+		}
+	}
+}
