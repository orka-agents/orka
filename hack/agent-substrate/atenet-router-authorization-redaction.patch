+func assertHeaderFreeAccessLogs(t *testing.T, listenersMap map[string]types.Resource) {
+	t.Helper()
+
+	const wantFormat = "[%START_TIME%] protocol=%PROTOCOL% response_code=%RESPONSE_CODE% response_flags=%RESPONSE_FLAGS% bytes_received=%BYTES_RECEIVED% bytes_sent=%BYTES_SENT% duration_ms=%DURATION%\n"
+	var hcmCount int
+	for listenerName, raw := range listenersMap {
+		listener := raw.(*listenerv3.Listener)
+		for _, filterChain := range listener.GetFilterChains() {
+			for _, filter := range filterChain.GetFilters() {
+				if filter.GetName() != "envoy.filters.network.http_connection_manager" {
+					continue
+				}
+				hcmCount++
+				var hcm hcmv3.HttpConnectionManager
+				if err := filter.GetTypedConfig().UnmarshalTo(&hcm); err != nil {
+					t.Fatalf("listener %q has invalid HTTP connection manager config: %v", listenerName, err)
+				}
+				if len(hcm.GetAccessLog()) == 0 {
+					t.Fatalf("listener %q has no access logger", listenerName)
+				}
+				for _, logger := range hcm.GetAccessLog() {
+					var stdoutLog streamaccesslogv3.StdoutAccessLog
+					if err := logger.GetTypedConfig().UnmarshalTo(&stdoutLog); err != nil {
+						t.Fatalf("listener %q has invalid stdout access logger config: %v", listenerName, err)
+					}
+					format := stdoutLog.GetLogFormat().GetTextFormatSource().GetInlineString()
+					if format != wantFormat {
+						t.Errorf("listener %q access-log format = %q, want %q", listenerName, format, wantFormat)
+					}
+					for _, headerFormatter := range []string{"%REQ(", "%REQ_WITHOUT_QUERY(", "%RESP(", "%TRAILER("} {
+						if strings.Contains(format, headerFormatter) {
+							t.Errorf("listener %q access-log format contains header formatter %q", listenerName, headerFormatter)
+						}
+					}
+				}
+			}
+		}
+	}
+	if hcmCount != len(listenersMap) {
+		t.Fatalf("inspected %d HTTP connection managers for %d listeners", hcmCount, len(listenersMap))
+	}
+}
