# The docs snapshot needs docs, chart values and skills that the production
# build context excludes, and nothing else.
**
!README.md
!SECURITY.md
!website/
!website/docs/
!website/docs/**
!docs/
!docs/adr/
!docs/adr/**
!docs/development/
!docs/development/**
!api/
!api/**/*.go
api/**/*_test.go
!config/
!config/crd/
!config/crd/bases/
!config/crd/bases/workspace.orka.ai_*.yaml
!manifest_staging/
!manifest_staging/charts/
!manifest_staging/charts/orka/
!manifest_staging/charts/orka/values.yaml
!charts/
!charts/orka/
!charts/orka/values.yaml
!.agents/
!.agents/skills/
!.agents/skills/**
