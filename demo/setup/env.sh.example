# Copy to demo/setup/env.sh and adjust. Sourced by every demo. No secrets:
# tokens are minted from the cluster at run time.
export KUBECONFIG="$HOME/projects/orka-demos/bin/substrate-eval/kubeconfig"
export ORKA_NAMESPACE=orka-system
export ORKA_RUNTIME_NAMESPACE=orka-runtimes
export ORKA_API=http://127.0.0.1:8080
export ORKA_API_SERVICE=orka-api
export DEMO_REPO=https://github.com/sozercan/orka-demo-inventory
export DEMO_REPO_BRANCH=main
export DEMO_GIT_SECRET=github-credentials

# Native AI assistants in demos 09 and 10 use this prepared Provider and model.
export DEMO_PROVIDER_REF=copilot
export DEMO_AI_MODEL=claude-opus-4.7
# Adapter/integration source checkouts used only during setup for demos 08 and 09.
# export DEMO_A2A_REPO="$HOME/projects/orka-gateway-a2a"
# export AGENTGATEWAY_SOURCE="$HOME/projects/orka-integration-agentgateway"

# Demo 11 needs a controller and a prepared Fibey runtime with PR #589 support.
# Setup reads the committed approval example from this checkout, without editing it.
# export DEMO_APPROVAL_SOURCE="$HOME/projects/orka.human-approval-v2"
# export DEMO_FIBEY_RUNTIME=fibey-approval-agentkit-runtime

# Demo 13 runs the same approval flow on an Orka-hosted and a Foundry-hosted
# Fibey. See demo/13-fibey-hosted-approval/README.md for each value.
# export ORKA_CLIENT_SA=orka-client
# export FIBEY_HOSTED_SUBSCRIPTION=<subscription id>
# export FIBEY_HOSTED_RESOURCE_GROUP=<Foundry resource group>
# export FIBEY_HOSTED_ACCOUNT=<Foundry account>
# export FIBEY_HOSTED_PROJECT=<Foundry project with hosted agents enabled>
# export FIBEY_HOSTED_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# export FIBEY_HOSTED_REGISTRY=<ACR the project identity can pull from>
# export FIBEY_HOSTED_MODEL=gpt-4.1-mini
# Demo 14's coordinator model, served by the same Vekil. AgentKit's Fibey needs a
# model that accepts function tools on Chat Completions (gpt-6-luna does not).
# export FIBEY_FLOW_MODEL=gpt-6-luna
# export FIBEY_HOSTED_AGENT=fibey-hosted
# export FIBEY_HOSTED_IDENTITY_CLIENT_ID=<workload identity client ID with Azure AI User on the project>
# export FIBEY_HOSTED_IMAGE_REPOSITORY=docker.io/<you>
