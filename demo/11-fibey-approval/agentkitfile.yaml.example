#syntax=ghcr.io/sozercan/agentkit/agentkit:latest
# Override the frontend and adapter with qualified source-built image digests.
# This builds the custom assistant; it is not an Orka Agent manifest.
apiVersion: v1alpha1
kind: Agent
metadata:
  name: fibey
runtime: microsoft-agent-framework
model:
  provider: openai-compatible
  baseURL: https://api.openai.com/v1
  name: gpt-4.1
  apiKeyEnv: OPENAI_API_KEY
instructions: |
  You are Fibey, an operations assistant investigating equipment alerts.
  Separate observations from hypotheses. Use the requested inventory and
  work-order tools once each. Orka requires a person to approve a work order;
  wait for the tool's final response. Report its actual workOrderID, or explain
  its denial or error. Never retry a declined, failed, or uncertain action.
  Do not claim that equipment was inspected, repaired, or changed.
expose:
  openai: true
  port: 8080
